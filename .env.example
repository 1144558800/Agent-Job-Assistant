# -------------------------------------------------------
# Agent 求职筛选助手 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# -------------------------------------------------------

# -------- AI 配置 --------
# DeepSeek API Key（必填）https://platform.deepseek.com/api_keys
AI_API_KEY=sk-your-deepseek-api-key

# DeepSeek API 地址
AI_API_BASE=https://api.deepseek.com

# AI 模型名称
AI_MODEL=deepseek-chat

# -------- 简历解析 --------
# 简历上传目录
UPLOAD_DIR=./uploads
# 处理后简历输出目录
POLISHED_DIR=./polished_resumes

# -------- RAG / 向量数据库 --------
FAISS_INDEX_DIR=./data/faiss_index
SCHEDULE_DIR=./data/schedules

# -------- 爬虫配置 --------
# 各平台 Cookie 文件路径（自动生成，无需手动修改）
BOSS_COOKIE_FILE=./scrapers/boss_cookies.json
LIEPIN_COOKIE_FILE=./scrapers/liepin_cookies.json
JOB51_COOKIE_FILE=./scrapers/job51_cookies.json
ZHAOPIN_COOKIE_FILE=./scrapers/zhaopin_cookies.json

# -------- 本地模型（可选的 Ollama）--------
# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 模型名称
OLLAMA_MODEL=qwen2.5:7b

# -------- 安全 --------
# Guardrails: 小时级最大投递数
MAX_APPLY_PER_HOUR=30
# Guardrails: 时间窗口(秒)
SAFETY_WINDOW=3600
# 需要确认的危险操作（逗号分隔）
CONFIRM_REQUIRED_TOOLS=auto_apply_jobs,auto_communicate
