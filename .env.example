# ============================================
# Agent 求职筛选助手 - 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env
# ============================================

# ---- 必填：AI 模型配置 ----
# 推荐使用 DeepSeek API，注册地址: https://platform.deepseek.com
AI_API_KEY=your_deepseek_api_key_here
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 如果使用其他 OpenAI 兼容的 API（如 OpenAI、通义千问、智谱等）
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- 可选：高德地图 API ----
# 用于岗位地点搜索等功能，注册地址: https://lbs.amap.com
AMAP_API_KEY=

# ---- 可选：Ollama 本地模型 ----
# 用于离线场景，需先安装 Ollama: https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---- 可选：服务器配置 ----
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8001
